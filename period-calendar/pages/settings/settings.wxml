<!-- pages/settings/settings.wxml -->
<view class="page">
  <!-- 用户区域 -->
  <view class="user-card">
    <view class="avatar-default">
      <text class="avatar-text">我</text>
    </view>
    <text class="user-name">经期日历用户</text>
    <text class="user-hint">记录越多，预测越准 ✨</text>
  </view>

  <!-- 个性化设置 -->
  <view class="section">
    <text class="section-title">周期设置</text>

    <view class="setting-item">
      <text class="setting-label">默认周期天数</text>
      <input
        class="setting-input"
        type="number"
        value="{{defaultCycleLength}}"
        bindblur="onCycleChange"
        placeholder="28"
      />
    </view>

    <view class="setting-item">
      <text class="setting-label">默认经期天数</text>
      <input
        class="setting-input"
        type="number"
        value="{{defaultPeriodLength}}"
        bindblur="onPeriodChange"
        placeholder="5"
      />
    </view>
  </view>

  <!-- 提醒设置 -->
  <view class="section">
    <text class="section-title">提醒设置</text>

    <view class="setting-item">
      <text class="setting-label">提前提醒</text>
      <view class="picker-wrap">
        <picker
          mode="selector"
          range="{{['1天前', '2天前', '3天前', '5天前', '7天前']}}"
          value="{{remindBefore === 1 ? 0 : remindBefore === 2 ? 1 : remindBefore === 3 ? 2 : remindBefore === 5 ? 3 : 4}}"
          bindchange="onRemindBeforeChange"
        >
          <text class="picker-val">{{remindBefore}}天前</text>
        </picker>
      </view>
    </view>

    <view class="setting-item">
      <text class="setting-label">开启提醒</text>
      <switch
        checked="{{remindEnabled}}"
        color="#E84A6B"
        bindchange="onRemindToggle"
      />
    </view>

    <!-- 订阅消息授权 -->
    <view class="section-subtitle">消息授权</view>
    <remind-btn
      mode="inline"
      auto-hide="{{false}}"
      bind:subscribed="onRemindSubscribed"
      bind:cancelled="onRemindCancelled"
    />
  </view>

  <!-- 保存按钮 -->
  <button class="save-btn" bindtap="saveSettings">保存设置</button>

  <!-- 关于 -->
  <view class="about">
    <text class="about-text">经期日历 v1.0.0</text>
    <text class="about-sub">你的数据仅保存在你的账户下，安全私密 🔒</text>
  </view>
</view>
