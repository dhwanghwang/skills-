/* pages/settings/settings.wxss */

.page {
  min-height: 100vh;
  background: #F8F8F8;
  padding-bottom: 40rpx;
}

/* 用户卡片 */
.user-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, #E84A6B, #F06292);
  padding: 48rpx 24rpx;
  margin-bottom: 32rpx;
}

.avatar-default {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.avatar-text {
  font-size: 36rpx;
  color: #fff;
  font-weight: 500;
}

.user-name {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.user-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 设置分组 */
.section {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  display: block;
  font-size: 24rpx;
  color: #999;
  padding: 24rpx 0 12rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 28rpx;
  color: #333;
}

.setting-input {
  width: 120rpx;
  text-align: right;
  font-size: 28rpx;
  color: #E84A6B;
  font-weight: 500;
}

.picker-wrap {
  font-size: 28rpx;
}

.picker-val {
  color: #E84A6B;
  font-weight: 500;
}

.arrow {
  font-size: 24rpx;
  color: #CCC;
}

.section-subtitle {
  font-size: 24rpx;
  color: #999;
  padding: 16rpx 0 8rpx;
}

/* remind-btn 在设置页的间距 */
.section .remind-btn--inline {
  margin: 8rpx 0 16rpx;
}

/* 保存按钮 */
.save-btn {
  margin: 40rpx 24rpx;
  background: #E84A6B;
  color: #fff;
  font-size: 30rpx;
  border-radius: 16rpx;
  border: none;
}

.save-btn::after {
  border: none;
}

/* 关于 */
.about {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
}

.about-text {
  font-size: 24rpx;
  color: #C0C0C0;
  margin-bottom: 8rpx;
}

.about-sub {
  font-size: 22rpx;
  color: #D0D0D0;
}
