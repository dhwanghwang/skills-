/* pages/calendar/calendar.wxss */

.page {
  min-height: 100vh;
  background: #FBEAF0;
  padding-bottom: 60rpx;
}

.calendar-section {
  margin: 24rpx;
}

/* ========== 图例 ========== */

.legend {
  display: flex;
  justify-content: center;
  gap: 36rpx;
  padding: 20rpx 24rpx;
  margin: 0 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #888;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.legend-dot.period-solid {
  background: #E84A6B;
}

.legend-dot.period-dashed {
  border: 3rpx dashed #F5A0B5;
  background: transparent;
}

.legend-dot.ovulation {
  background: #5B9BD5;
}

.legend-dot.fertile {
  background: #D6E8F7;
  border: 1rpx solid #B0C8E0;
}

/* ========== 操作提示 ========== */

.quick-actions {
  text-align: center;
  padding: 28rpx;
}

.hint {
  font-size: 24rpx;
  color: #C0A0A8;
}

/* ========================================
   底部操作面板
   ======================================== */

.panel-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s, visibility 0.25s;
}

.panel-mask.show {
  opacity: 1;
  visibility: visible;
}

.panel {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 32rpx 40rpx;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -4rpx 30rpx rgba(0, 0, 0, 0.10);
}

.panel.show {
  transform: translateY(0);
}

.panel-handle {
  width: 60rpx;
  height: 8rpx;
  background: #E0E0E0;
  border-radius: 4rpx;
  margin: 0 auto 24rpx;
}

.panel-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
}

.panel-subtitle {
  display: block;
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-top: 8rpx;
  margin-bottom: 28rpx;
}

/* 快捷天数选择 */
.duration-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-bottom: 28rpx;
}

.duration-pill {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #F5F5F5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.duration-pill.active {
  background: #E84A6B;
  box-shadow: 0 4rpx 16rpx rgba(232, 74, 107, 0.35);
}

.pill-days {
  font-size: 36rpx;
  font-weight: 700;
  color: #666;
  line-height: 1;
}

.duration-pill.active .pill-days {
  color: #fff;
}

.pill-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}

.duration-pill.active .pill-label {
  color: rgba(255, 255, 255, 0.8);
}

/* 预览条 */
.preview-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #FBEAF0;
  border-radius: 16rpx;
  margin-bottom: 28rpx;
}

.preview-label {
  font-size: 24rpx;
  color: #C08090;
}

.preview-range {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.preview-date {
  font-size: 28rpx;
  color: #E84A6B;
  font-weight: 600;
}

.preview-arrow {
  font-size: 24rpx;
  color: #C08090;
}

/* 底部按钮 */
.panel-actions {
  display: flex;
  gap: 20rpx;
}

.panel-actions.single {
  flex-direction: column;
}

.p-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  background: none;
  line-height: 1;
}

.p-btn::after {
  border: none;
}

.p-btn.cancel {
  background: #F5F5F5;
  color: #888;
}

.p-btn.confirm {
  background: #E84A6B;
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(232, 74, 107, 0.30);
}

.p-btn.danger {
  background: #FFF0F0;
  color: #E84A6B;
}
