<!-- components/cycle-summary/cycle-summary.wxml -->
<view class="summary-wrap" wx:if="{{showCard}}">
  <view class="summary-card {{isPeriodActive ? 'period-active' : ''}}">
    <!-- 顶部状态 -->
    <view class="card-top">
      <view class="emoji-circle">
        <text class="emoji">{{statusEmoji}}</text>
      </view>
      <view class="status-texts">
        <text class="status-title">{{statusText}}</text>
        <text class="status-sub" wx:if="{{periodProgress}}">{{periodProgress}}</text>
      </view>
    </view>

    <!-- 分隔 -->
    <view class="divider"></view>

    <!-- 核心数据行 -->
    <view class="stats-row">
      <view class="stat-col">
        <text class="stat-label">平均周期</text>
        <view class="stat-value-row">
          <text class="stat-value">{{prediction.avgCycleLength}}</text>
          <text class="stat-unit">天</text>
        </view>
      </view>
      <view class="stat-col">
        <text class="stat-label">经期时长</text>
        <view class="stat-value-row">
          <text class="stat-value">{{prediction.avgPeriodLength}}</text>
          <text class="stat-unit">天</text>
        </view>
      </view>
      <view class="stat-col">
        <text class="stat-label">下次预计</text>
        <view class="stat-value-row next-date">
          <text class="stat-value">{{prediction.nextPeriodStart}}</text>
        </view>
      </view>
    </view>

    <!-- 排卵日额外行 -->
    <view class="ovulation-row" wx:if="{{!isPeriodActive && prediction.ovulationDay}}">
      <text class="ovu-label">预计排卵日 {{prediction.ovulationDay}}</text>
      <text class="ovu-sub">易孕期 {{prediction.fertileWindow.start}} ~ {{prediction.fertileWindow.end}}</text>
    </view>

    <!-- 置信度 -->
    <text class="confidence-tag">{{confidenceText}}</text>
  </view>
</view>
