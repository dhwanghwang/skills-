/* components/cycle-summary/cycle-summary.wxss */

.summary-wrap {
  padding: 24rpx 24rpx 8rpx;
}

.summary-card {
  background: linear-gradient(145deg, #E84A6B, #F06292);
  border-radius: 28rpx;
  padding: 32rpx 28rpx 24rpx;
  color: #fff;
  box-shadow: 0 6rpx 28rpx rgba(232, 74, 107, 0.28);
  overflow: hidden;
}

.summary-card.period-active {
  background: linear-gradient(145deg, #D6405C, #E84A6B);
}

/* ---------- 顶部状态 ---------- */

.card-top {
  display: flex;
  align-items: center;
}

.emoji-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.emoji {
  font-size: 40rpx;
  line-height: 1;
}

.status-texts {
  display: flex;
  flex-direction: column;
}

.status-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
}

.status-sub {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

/* ---------- 分隔线 ---------- */

.divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.20);
  margin: 20rpx 0 16rpx;
}

/* ---------- 三列数据 ---------- */

.stats-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.stat-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.75;
  margin-bottom: 6rpx;
}

.stat-value-row {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.stat-unit {
  font-size: 22rpx;
  opacity: 0.75;
}

.next-date .stat-value {
  font-size: 24rpx;
  white-space: nowrap;
}

/* ---------- 排卵信息 ---------- */

.ovulation-row {
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ovu-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #fff;
}

.ovu-sub {
  font-size: 22rpx;
  opacity: 0.75;
}

/* ---------- 置信度 ---------- */

.confidence-tag {
  display: block;
  text-align: center;
  font-size: 22rpx;
  opacity: 0.65;
  padding-top: 4rpx;
}
