/* components/calendar-grid/calendar-grid.wxss */

.calendar {
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx 12rpx 12rpx;
  box-shadow: 0 4rpx 24rpx rgba(232, 74, 107, 0.06);
  position: relative;
}

/* ---------- 月份导航 ---------- */

.cal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx 20rpx;
}

.month-nav {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F8F8F8;
  transition: background 0.2s;
}

.month-nav:active {
  background: #EEEEEE;
}

.nav-arrow {
  font-size: 32rpx;
  color: #666;
  line-height: 1;
}

.month-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  letter-spacing: 2rpx;
}

/* ---------- 星期头 ---------- */

.weekday-row {
  display: flex;
  margin-bottom: 8rpx;
  padding: 0 4rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #B0B0B0;
  padding: 12rpx 0;
  font-weight: 500;
}

.weekday.sun { color: #E84A6B; }
.weekday.sat { color: #5B9BD5; }

/* ---------- 日期网格 ---------- */

.date-grid {
  display: flex;
  flex-wrap: wrap;
}

.date-cell {
  position: relative;
  width: calc(100% / 7);
  padding-bottom: calc(100% / 7);
  box-sizing: border-box;
}

.date-cell.outside .date-num {
  color: #D8D8D8;
}

/* 日期数字 */
.date-num {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #333;
  z-index: 5;
  font-weight: 400;
  transition: color 0.15s;
}

/* ---------- 经期高亮（深粉实心圆底） ---------- */

.period-highlight {
  position: absolute;
  top: 8%;
  left: 8%;
  right: 8%;
  bottom: 8%;
  border-radius: 50%;
  background: #E84A6B;
  z-index: 1;
  opacity: 0.18;
}

/* ---------- 预测经期虚线圈 ---------- */

.predicted-ring {
  position: absolute;
  top: 8%;
  left: 8%;
  right: 8%;
  bottom: 8%;
  border-radius: 50%;
  border: 3rpx dashed #F5A0B5;
  z-index: 1;
}

/* ---------- 易孕期底色 ---------- */

.fertile-bg {
  position: absolute;
  top: 4%;
  left: 4%;
  right: 4%;
  bottom: 4%;
  background: #EDF4FB;
  border-radius: 50%;
  z-index: 0;
}

/* ---------- 排卵日蓝点 ---------- */

.ovulation-dot {
  position: absolute;
  top: 8%;
  right: 12%;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #5B9BD5;
  z-index: 6;
}

/* ---------- 今日圆环 ---------- */

.today-ring {
  position: absolute;
  top: 10%;
  left: 10%;
  right: 10%;
  bottom: 10%;
  border-radius: 50%;
  border: 3rpx solid #333;
  z-index: 4;
}

/* ---------- 点击反馈 ---------- */

.date-cell:active::after {
  content: '';
  position: absolute;
  top: 10%;
  left: 10%;
  right: 10%;
  bottom: 10%;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.06);
  z-index: 3;
}

/* ---------- 回到今天按钮 ---------- */

.back-today {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  background: #E84A6B;
  color: #fff;
  font-size: 22rpx;
  font-weight: 500;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  z-index: 10;
  opacity: 0;
  transform: scale(0.8);
  pointer-events: none;
  transition: all 0.25s cubic-bezier(0.18, 0.89, 0.32, 1.28);
  box-shadow: 0 4rpx 12rpx rgba(232, 74, 107, 0.30);
}

.back-today.show {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
}

.back-today-text {
  color: #fff;
}
