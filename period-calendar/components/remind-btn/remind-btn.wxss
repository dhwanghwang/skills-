/* remind-btn 样式 */

/* ========== 未订阅按钮 ========== */
.remind-btn {
  display: flex;
  align-items: center;
  border-radius: 16rpx;
  transition: all 0.25s;
}

/* inline — 行内（设置页） */
.remind-btn--inline {
  background: linear-gradient(135deg, #E84A6B, #F06292);
  padding: 20rpx 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.remind-btn--inline .remind-icon {
  width: 64rpx;
  height: 64rpx;
}

.remind-btn--inline .remind-title {
  font-size: 28rpx;
}

.remind-btn--inline .remind-sub {
  font-size: 22rpx;
}

/* card — 卡片横幅（日历页标记后） */
.remind-btn--card {
  background: linear-gradient(135deg, #FFF5F7, #FFF0F3);
  border: 2rpx solid #F5A0B5;
  padding: 24rpx;
  margin: 16rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(232, 74, 107, 0.08);
}

.remind-btn--card .remind-icon {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #E84A6B, #F06292);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.remind-btn--card .remind-title {
  font-size: 28rpx;
  color: #E84A6B;
  font-weight: 600;
}

.remind-btn--card .remind-sub {
  font-size: 22rpx;
  color: #F5A0B5;
}

.remind-btn--card .remind-arrow text {
  color: #E84A6B;
}

/* float — 浮动按钮 */
.remind-btn--float {
  position: fixed;
  bottom: 120rpx;
  right: 32rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E84A6B, #F06292);
  box-shadow: 0 8rpx 24rpx rgba(232, 74, 107, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 0;
}

.remind-btn--float .remind-icon {
  margin-bottom: 4rpx;
}

.remind-btn--float .remind-title {
  font-size: 18rpx;
  color: #fff;
  text-align: center;
}

.remind-btn--float .remind-sub,
.remind-btn--float .remind-arrow {
  display: none;
}

/* ========== 共享元素 ========== */
.remind-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
}

.remind-title {
  color: #fff;
  font-weight: 600;
  line-height: 1.4;
}

.remind-sub {
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.4;
  margin-top: 4rpx;
}

.remind-arrow {
  margin-left: 12rpx;
}

.remind-arrow text {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ========== 铃铛摇动动画 ========== */
.shaking {
  animation: shake 0.5s ease-in-out infinite;
}

@keyframes shake {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-12deg); }
  50% { transform: rotate(0deg); }
  75% { transform: rotate(12deg); }
}

/* ========== 已订阅状态 ========== */
.remind-done {
  display: flex;
  align-items: center;
  justify-content: center;
}

.remind-done--card {
  background: #F0FFF4;
  border: 2rpx solid #C6F6D5;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 16rpx 0;
}

.remind-done--card .done-check {
  font-size: 26rpx;
  color: #38A169;
  font-weight: 500;
}

.remind-done--inline {
  background: #F0FFF4;
  border-radius: 12rpx;
  padding: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.remind-done--inline .done-check {
  font-size: 24rpx;
  color: #38A169;
}

.done-check {
  font-weight: 500;
}
