<!-- remind-btn 订阅消息按钮 -->

<!-- 未订阅：显示按钮 -->
<view
  wx:if="{{visible && !subscribed}}"
  class="remind-btn remind-btn--{{mode}}"
  bindtap="handleTap"
>
  <!-- 铃铛图标 -->
  <view class="remind-icon {{subscribing ? 'shaking' : ''}}">
    <!-- SVG 铃铛 -->
    <svg viewBox="0 0 24 24" width="40rpx" height="40rpx">
      <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"
        fill="#fff" />
    </svg>
  </view>

  <view class="remind-content">
    <text class="remind-title">{{reminderText || '开启经期提醒'}}</text>
    <text class="remind-sub">{{subscribing ? '正在唤起授权...' : '不再错过重要日子 ✨'}}</text>
  </view>

  <view class="remind-arrow">
    <text>›</text>
  </view>
</view>

<!-- 已订阅：显示状态 -->
<view
  wx:elif="{{visible && subscribed}}"
  class="remind-done remind-done--{{mode}}"
>
  <view class="done-check">✓ 提醒已开启</view>
</view>
